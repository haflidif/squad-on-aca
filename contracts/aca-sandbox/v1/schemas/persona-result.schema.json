{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haflidif/squad-on-aca/contracts/aca-sandbox/v1/schemas/persona-result.schema.json",
  "title": "ACA Sandbox persona result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_type",
    "run_id",
    "task_id",
    "owner",
    "status",
    "baseline_sha",
    "roster",
    "provider",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "message_type": {
      "type": "string",
      "const": "persona.result"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/member"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "cancelled"]
    },
    "summary": {
      "type": "string"
    },
    "baseline_sha": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "result_sha": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "roster": {
      "$ref": "common.schema.json#/$defs/roster"
    },
    "provider": {
      "$ref": "common.schema.json#/$defs/provider"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
