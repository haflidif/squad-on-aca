{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haflidif/squad-on-aca/contracts/aca-sandbox/v1/schemas/integration-result.schema.json",
  "title": "ACA Sandbox integration result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_type",
    "run_id",
    "provider",
    "baseline_sha",
    "roster",
    "status",
    "tasks",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "message_type": {
      "type": "string",
      "const": "integration.result"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "$ref": "common.schema.json#/$defs/provider"
    },
    "baseline_sha": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "result_sha": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "roster": {
      "$ref": "common.schema.json#/$defs/roster"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "partial"]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "status", "owner"],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "status": {
            "type": "string",
            "enum": ["succeeded", "failed", "cancelled", "skipped"]
          },
          "owner": {
            "$ref": "common.schema.json#/$defs/member"
          },
          "result_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
